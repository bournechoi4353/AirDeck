# Client (Vite) environment. Copy to client/.env. Vite only exposes VITE_-prefixed vars to the
# browser; the OAuth client ID is public (no secret), so this is safe to ship.

# Google OAuth client ID (Web application). Add http://localhost:5173 as an authorized JavaScript
# origin, and enable the Google Slides API + Google Drive API on the project.
VITE_GOOGLE_CLIENT_ID=

# Backend API origin. Leave blank in local dev so calls stay relative ("/api/...") and use the
# Vite proxy. In production (Vercel), set this to your Render service URL so the browser calls the
# backend directly, e.g. https://airdeck-server.onrender.com
VITE_API_URL=
