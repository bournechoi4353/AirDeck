# Backend
PORT=8787

# Claude Agent SDK (speaker notes) — subscription auth, NOT a raw API key.
# On a machine where you've logged into Claude Code, run:  claude setup-token
# then paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Google OAuth (Slides). The browser read-only flow (Phase 4B/4C) uses VITE_GOOGLE_CLIENT_ID in
# client/.env — see client/.env.example. These server vars are reserved for a future server-side /
# offline-refresh token flow and are unused today.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TTS provider — Phase 6 (provider TBD)
TTS_API_KEY=
